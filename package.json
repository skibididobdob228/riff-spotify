{
  "name": "riff-spotify",
  "version": "42.3.0",
  "main": "main.js",
  "bin": {
    "riff": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [],
  "author": "skibididobdob228",
  "license": "GPL-3.0-only",
  "description": "Riff with a Spotify search engine: Spotify catalog, YouTube Music audio.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Riff",
  "homepage": "https://github.com/skibididobdob228/riff-spotify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skibididobdob228/riff-spotify.git"
  },
  "bugs": {
    "url": "https://github.com/skibididobdob228/riff-spotify/issues"
  },
  "build": {
    "appId": "io.github.skibididobdob228.riffspotify",
    "productName": "Riff",
    "artifactName": "Riff-Spotify-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!bin/**",
      "!*.md",
      "!strip_comments.js",
      "!.riff_progress.md",
      "!package-lock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Riff Spotify",
      "uninstallDisplayName": "Riff Spotify"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "skibididobdob228",
        "repo": "riff-spotify",
        "releaseType": "release"
      }
    ]
  }
}
